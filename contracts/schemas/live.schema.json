{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live.schema.json",
  "title": "Live airport snapshot",
  "description": "Written by the backend poller every ~20 s. Read by the live map (screen 1).",
  "type": "object",
  "required": ["schema_version", "airport", "updated_utc", "conditions", "aircraft"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "sample": { "type": "boolean", "description": "true for hand-made sample files" },
    "airport": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "updated_utc": { "type": "string", "format": "date-time" },
    "conditions": {
      "type": "object",
      "required": ["metar", "runways", "landings_last_30min"],
      "additionalProperties": false,
      "properties": {
        "metar": { "type": ["string", "null"] },
        "metar_time_utc": { "type": ["string", "null"], "format": "date-time" },
        "runways": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "heading_deg", "crosswind_kt", "headwind_kt"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[0-3][0-9][LRC]?$" },
              "heading_deg": { "type": "number", "minimum": 0, "maximum": 360 },
              "crosswind_kt": { "type": ["number", "null"], "description": "absolute value" },
              "headwind_kt": { "type": ["number", "null"], "description": "negative = tailwind" },
              "active": { "type": "boolean" }
            }
          }
        },
        "landings_last_30min": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "aircraft": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["icao24", "callsign", "lat", "lon", "baro_alt_ft", "gs_kt", "vrate_fpm",
                     "heading_deg", "runway", "dist_nm", "risk", "risk_band", "trail"],
        "additionalProperties": false,
        "properties": {
          "icao24": { "type": "string", "pattern": "^[0-9a-f]{6}$" },
          "callsign": { "type": ["string", "null"] },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "baro_alt_ft": { "type": ["number", "null"] },
          "gs_kt": { "type": ["number", "null"] },
          "vrate_fpm": { "type": ["number", "null"] },
          "heading_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
          "runway": { "type": ["string", "null"], "description": "null until aligned with a runway" },
          "dist_nm": { "type": ["number", "null"], "minimum": 0, "description": "to runway threshold" },
          "risk": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "risk_band": { "enum": ["low", "medium", "high", null] },
          "flight_file": { "type": ["string", "null"], "description": "path to flights/{icao24}_{unix}.json" },
          "trail": {
            "type": "array",
            "description": "recent positions, oldest first, [lat, lon]",
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "minimum": -90, "maximum": 90 },
                { "type": "number", "minimum": -180, "maximum": 180 }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
